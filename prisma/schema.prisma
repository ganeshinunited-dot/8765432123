// Student Job Marketplace — Prisma schema (PostgreSQL)
// Designed per product spec: students, employers, admins. UUIDs, timestamps,
// foreign keys and indexes throughout. Works against local Postgres and
// Supabase Postgres (DATABASE_URL swap).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums
enum Role {
  STUDENT
  EMPLOYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_INFO
}

enum JobType {
  PART_TIME
  FULL_TIME
  INTERNSHIP
  TEMPORARY
  CONTRACT
}

enum WorkArrangement {
  ON_SITE
  REMOTE
  HYBRID
}

enum ScheduleSlot {
  MORNING
  AFTERNOON
  EVENING
  WEEKEND
}

enum SalaryType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  NEGOTIABLE
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum InterviewStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
}

enum ReportTargetType {
  JOB
  COMPANY
  USER
  MESSAGE
}

enum ReportReason {
  SCAM
  FAKE_JOB
  MISLEADING_SALARY
  HARASSMENT
  SPAM
  UNSAFE_REQUEST
  OTHER
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum PaymentProvider {
  ESEWA
  KHALTI
  MOCK
}

enum PaymentState {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  NEW_MATCHING_JOB
  APPLICATION_VIEWED
  SHORTLISTED
  REJECTED
  INTERVIEW_INVITATION
  NEW_MESSAGE
  JOB_EXPIRING
  PROFILE_REMINDER
  EMPLOYER_VERIFICATION
  PAYMENT_CONFIRMATION
  JOB_APPROVED
  JOB_REJECTED
  NEW_APPLICATION
  SYSTEM
}

// ---------------------------------------------------------------- users & auth
model User {
  id            String     @id @default(uuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String
  name          String
  role          Role       @default(STUDENT)
  isAdmin       Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  emailVerifyToken String?   @unique
  emailVerifyExpiry DateTime?
  resetToken    String?    @unique
  resetTokenExpiry DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions       Session[]
  studentProfile StudentProfile?
  companies      Company[]        @relation("CompanyOwner")
  notifications  Notification[]
  sentMessages   Message[]        @relation("MessageSender")
  reportsMade    Report[]         @relation("ReportReporter")
  adminActions   AdminAction[]    @relation("AdminActor")
  files          UploadedFile[]
  analytics      AnalyticsEvent[]

  @@index([role, status])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- locations & taxonomy
model Location {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  parentId String?
  parent   Location? @relation("LocationParent", fields: [parentId], references: [id])
  children Location[] @relation("LocationParent")

  studentProfiles StudentProfile[]
  companies       Company[]
  jobs            Job[]

  @@index([slug])
}

model JobCategory {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  active Boolean @default(true)

  jobs Job[]

  @@index([active])
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  studentSkills StudentSkill[]
  jobSkills     JobSkill[]
}

// ---------------------------------------------------------------- student
model StudentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  headline           String?
  bio                String?
  locationId         String?
  educationLevel     String?
  college            String?
  languages          String[] @default([])
  availability       Json? // { monday: [{start,end}], ... } + custom notes
  preferredJobTypes  JobType[] @default([])
  preferredSchedules ScheduleSlot[] @default([])
  preferredArrangement WorkArrangement?
  expectedSalaryMin  Int?
  expectedSalaryMax  Int?
  salaryType         SalaryType?
  portfolioLinks     Json? // [{label, url}]
  cvFileId           String?
  photoUrl           String?
  profileCompletion  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])
  skills   StudentSkill[]
  applications Application[]
  savedJobs   SavedJob[]

  @@index([locationId])
}

model StudentSkill {
  studentId String
  skillId   String
  level     String? // beginner | intermediate | advanced

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
}

// ---------------------------------------------------------------- employer / company
model Company {
  id                 String                    @id @default(uuid())
  ownerId            String
  name               String
  slug               String                    @unique
  logoUrl            String?
  industry           String?
  description        String?
  locationId         String?
  website            String?
  size               String?
  verificationStatus CompanyVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verificationExpiresAt DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  owner        User          @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id])
  jobs         Job[]
  verifications CompanyVerification[]
  subscriptions Subscription[]
  payments      Payment[]

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([slug])
}

model CompanyVerification {
  id          String                    @id @default(uuid())
  companyId   String
  businessInfo Json // { registrationNo, contactPerson, address, ... }
  documentIds String[]                  @default([])
  status      CompanyVerificationStatus @default(PENDING)
  reviewerId  String?
  reviewedAt  DateTime?
  expiresAt   DateTime?
  checks      Json? // auto-check snapshot + manual review checklist
  notes       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// ---------------------------------------------------------------- jobs
model Job {
  id               String           @id @default(uuid())
  slug             String           @unique
  companyId        String
  title            String
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?
  categoryId       String?
  jobType          JobType
  workArrangement  WorkArrangement  @default(ON_SITE)
  schedules        ScheduleSlot[]   @default([])
  locationId       String?
  salaryType       SalaryType       @default(NEGOTIABLE)
  salaryMin        Int?
  salaryMax        Int?
  currency         String           @default("NPR")
  openings         Int              @default(1)
  deadline         DateTime?
  status           JobStatus        @default(DRAFT)
  featured         Boolean          @default(false)
  urgentHiring     Boolean          @default(false)
  views            Int              @default(0)
  moderationNotes  String?
  publishedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     JobCategory?  @relation(fields: [categoryId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  skills       JobSkill[]
  applications Application[]
  savedBy      SavedJob[]

  @@index([status, publishedAt])
  @@index([companyId, status])
  @@index([categoryId])
  @@index([locationId])
  @@index([jobType, workArrangement])
  @@index([slug])
}

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

// ---------------------------------------------------------------- applications
model Application {
  id               String            @id @default(uuid())
  jobId            String
  studentId        String // StudentProfile.id
  coverMessage     String?
  cvFileId         String?
  answers          Json? // employer-specific question answers
  availabilityNote String?
  status           ApplicationStatus @default(APPLIED)
  appliedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  history     ApplicationStatusHistory[]
  interviews  Interview[]
  conversation Conversation?

  @@unique([jobId, studentId])
  @@index([studentId, status])
  @@index([jobId, status])
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model SavedJob {
  studentId String
  jobId     String
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([studentId, jobId])
  @@index([studentId])
}

// ---------------------------------------------------------------- messaging & interviews
model Conversation {
  id            String   @id @default(uuid())
  applicationId String   @unique
  studentId     String // User.id
  employerId    String // User.id
  blockedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([studentId])
  @@index([employerId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  proposedById  String
  dateTime      DateTime
  location      String?
  meetingLink   String?
  notes         String?
  status        InterviewStatus @default(PROPOSED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// ---------------------------------------------------------------- notifications
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------------------------------------------------------------- reports & moderation
model Report {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  details     String?
  status      ReportStatus     @default(OPEN)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------- billing
model SubscriptionPlan {
  id              String  @id @default(uuid())
  name            String
  slug            String  @unique
  description     String?
  priceMonthly    Int     @default(0) // in NPR
  currency        String  @default("NPR")
  jobPostLimit    Int     @default(3)
  featuredAllowed Boolean @default(false)
  candidateSearch Boolean @default(false)
  active          Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endsAt    DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([companyId, status])
}

model Payment {
  id             String         @id @default(uuid())
  companyId      String
  subscriptionId String?
  provider       PaymentProvider
  amount         Int // NPR
  currency       String          @default("NPR")
  state          PaymentState    @default(PENDING)
  providerRef    String?
  rawResponse    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId, state])
}

// ---------------------------------------------------------------- files
model UploadedFile {
  id          String   @id @default(uuid())
  ownerId     String
  purpose     String // CV | PHOTO | DOCUMENT | LOGO
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, purpose])
}

// ---------------------------------------------------------------- cms, audit, analytics
model CmsPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  action     String // e.g. JOB_APPROVED, EMPLOYER_SUSPENDED
  targetType String?
  targetId   String?
  reason     String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  event     String // signup, job_view, application_submitted, ...
  props     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
}
