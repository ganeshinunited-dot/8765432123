# --- Database ---
# Local Postgres example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobplatform?schema=public"
# Supabase Postgres example:
# DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="sjp_session"
# 32+ random bytes hex. Generate: openssl rand -hex 32
SESSION_SECRET=""

# --- Storage ---
# local | s3   (s3 covers S3-compatible stores incl. Supabase Storage via S3 API)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# S3_STORAGE_ENDPOINT, S3_STORAGE_REGION, S3_STORAGE_BUCKET
# S3_STORAGE_ACCESS_KEY, S3_STORAGE_SECRET_KEY

# --- Email ---
# log | smtp | resend
EMAIL_DRIVER="log"
EMAIL_FROM="noreply@example.com"
# EMAIL_SMTP_HOST, EMAIL_SMTP_PORT, EMAIL_SMTP_USER, EMAIL_SMTP_PASS
# RESEND_API_KEY

# --- Payments ---
# mock | esewa | khalti
PAYMENT_DRIVER="mock"
# ESEWA_MERCHANT_ID, ESEWA_SECRET_KEY, ESEWA_MODE=test
# KHALTI_PUBLIC_KEY, KHALTI_SECRET_KEY

# --- Maps ---
# none | google | mapbox
MAPS_PROVIDER="none"
# MAPS_API_KEY

# --- OAuth (optional) ---
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET

# --- Admin bootstrap (seed script only) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- AI features (optional) ---
# Without a key, AI features use built-in smart templates (still fully functional).
# Any OpenAI-compatible provider works (OpenAI, Gemini, Groq, Together, Llama API).
# NEVER commit a real key; set it in your hosting provider's env settings.
AI_API_KEY=
AI_BASE_URL=https://api.meta.ai/v1
AI_MODEL=muse-spark-1.1

# --- Klaviyo marketing (server-only; NEVER prefix with NEXT_PUBLIC_) ---
# Create a Private API Key in Klaviyo: Settings -> API Keys.
# Create a marketing List in Klaviyo and use its list ID below.
# Until both are set, the integration safely no-ops.
# KLAVIYO_PRIVATE_KEY=
# KLAVIYO_MARKETING_LIST_ID=
